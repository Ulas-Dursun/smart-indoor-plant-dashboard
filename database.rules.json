{
  "rules": {
    ".read": false,
    ".write": false,

    "sensors": {
      ".read": true,
      ".write": "auth != null",
      ".validate": "newData.hasChildren(['moisture', 'temperature', 'humidity'])",
      "moisture": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "temperature": {
        ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 85"
      },
      "humidity": {
        ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
      },
      "light": {
        ".validate": "newData.isNumber() || newData.isString()"
      },
      "lastUpdated": {
        ".validate": "newData.isString() || newData.isNumber()"
      },
      "$other": {
        ".validate": false
      }
    },

    "actuators": {
      ".read": true,
      ".write": "auth != null",
      "waterPump": {
        ".validate": "newData.isBoolean()"
      },
      "fan": {
        ".validate": "newData.isBoolean()"
      },
      "growLight": {
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      }
    },

    "status": {
      ".read": true,
      ".write": "auth != null",
      "fan": {
        ".validate": "newData.isBoolean()"
      },
      "led": {
        ".validate": "newData.isBoolean()"
      },
      "$other": {
        ".validate": false
      }
    },

    "system": {
      ".read": true,
      ".write": "auth != null",
      "enabled": {
        ".validate": "newData.isBoolean()"
      },
      "mode": {
        ".validate": "newData.isString() && (newData.val() === 'AUTO' || newData.val() === 'MANUAL')"
      },
      "thresholds": {
        ".validate": "newData.hasChildren(['minMoisture', 'maxMoisture', 'maxPumpDurationSec', 'cooldownMinutes'])",
        "plantProfileId": {
          ".validate": "newData.isString() && newData.val().length <= 50"
        },
        "minMoisture": {
          ".validate": "newData.isNumber() && newData.val() >= 5 && newData.val() <= 85"
        },
        "maxMoisture": {
          ".validate": "newData.isNumber() && newData.val() >= 15 && newData.val() <= 95 && newData.val() > data.parent().child('minMoisture').val()"
        },
        "maxPumpDurationSec": {
          ".validate": "newData.isNumber() && newData.val() >= 3 && newData.val() <= 60"
        },
        "cooldownMinutes": {
          ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 60"
        },
        "$other": {
          ".validate": false
        }
      },
      "$other": {
        ".validate": false
      }
    },

    "history": {
      "moisture": {
        ".read": true,
        ".write": "auth != null",
        "$recordId": {
          ".validate": "newData.hasChildren(['time', 'moisture'])",
          "time": {
            ".validate": "newData.isString() || newData.isNumber()"
          },
          "value": {
            ".validate": "newData.isNumber()"
          },
          "moisture": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "temperature": {
            ".validate": "newData.isNumber() && newData.val() >= -40 && newData.val() <= 85"
          },
          "humidity": {
            ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100"
          },
          "$other": {
            ".validate": false
          }
        }
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
